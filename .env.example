# ShellSpace — Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT COMMIT .env or .env.local to version control

# ─── DATABASE (Supabase PostgreSQL) ──────────────────────────────────────────
# Transaction-mode pooler (for app runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode (for Prisma migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ─── AUTHENTICATION (NextAuth.js) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-char-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── STORAGE ─────────────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"   # "local" | "s3"

# ─── EXECUTION RUNNER (bash sandbox) ─────────────────────────────────────────
RUNNER_URL="http://localhost:8080"
RUNNER_SECRET="your-runner-secret"
RUNNER_MAX_CONCURRENT=10

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ShellSpace"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── EXECUTION LIMITS ─────────────────────────────────────────────────────────
EXEC_TIMEOUT_SEC=5
EXEC_MEMORY_LIMIT_MB=128
EXEC_MAX_OUTPUT_BYTES=1048576
EXEC_MAX_CONCURRENT_PER_USER=2
